{
  "manifest_version": 3,
  "name": "課題RPG（動作確認用）",
  "version": "0.1",
  "description": "ゲームの仕組みと締め切り警告の動作確認用",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "debug.html"
  },
  "icons": {
    "128": "images/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["game.js", "content.js"]
    }
  ]
}